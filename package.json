{
  "name": "raunaks-resrescue",
  "private": true,
  "version": "1.7.6",
  "description": "Free AI-powered ATS Resume Optimizer using Google Gemini",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@react-pdf/renderer": "^3.4.5",
    "clsx": "^2.1.0",
    "docx": "^9.7.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^4.4.0"
  },
  "build": {
    "appId": "com.raunakpatil.resrescue",
    "productName": "Raunak's ResRescue",
    "copyright": "Copyright © 2024 raunakpatil",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "extraResources": [],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Raunaks-ResRescue-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raunak's ResRescue",
      "include": "build/installer.nsh",
      "perMachine": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
